<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews
    </IfModule>

    RewriteEngine On
    # Kalpana (./kalpana, the Design My Lab planner) runs as its own service on 127.0.0.1:8787 and is
    # served under /kalpana/. Needs mod_proxy + mod_proxy_http (or use ProxyPass in the vhost instead).
    <IfModule mod_proxy.c>
        RewriteRule ^kalpana$ /kalpana/ [R=301,L]
        RewriteRule ^kalpana/(.*)$ http://127.0.0.1:8787/$1 [P,L]
    </IfModule>
    RewriteRule ^update - [L]
    RewriteRule ^club-shop(/.*)?$ - [L]
    RewriteCond %{REQUEST_FILENAME} -d [OR]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ ^$1 [N]

    RewriteCond %{REQUEST_URI} (\.\w+$) [NC]
    RewriteRule ^(.*)$ public/$1

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ server.php


</IfModule>

# DO NOT REMOVE THIS LINE AND THE LINES BELOW HOTLINKID:IvUCYBgyyr
RewriteEngine on
RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?myskill.club/.*$      [NC]
RewriteRule .*\.(zip|rar|exe)$ https://myskill.club [R,NC]
