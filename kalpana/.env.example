HOST=127.0.0.1
PORT=8787
# Origin used in integration launch/result links; use your HTTPS domain when hosted.
PUBLIC_URL=http://localhost:8787
DATA_DIR=./data
GEMINI_API_KEY=
# Set to a model enabled for your Gemini API project.
GEMINI_MODEL=gemini-3.8-flash
AI_MODE=gemini
ADMIN_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN_OF_AT_LEAST_32_CHARACTERS
# Purchase provider is undecided. Requests are stored for follow-up.
CHECKOUT_MODE=request
# Origins allowed to embed Kalpana; space separated. 'self' is always allowed.
EMBED_ORIGINS=http://localhost:8080 http://localhost:5173
# Enable clearly labeled sample documents/catalog for initial testing only.
SEED_DEMO=false
# Product source. "skillvation" syncs products from the Skillvation Club Shop and MySkool
# collab course APIs (prices in INR) and publishes a new catalog revision when they change.
CATALOG_SOURCE=skillvation
SKILLVATION_SHOP_URL=https://devpro.skillvation.com/club-shop
SKILLVATION_COURSES_URL=https://collab.myskool.club
SKILLVATION_SYNC_MINUTES=60
# false = stage changes for an administrator to publish from /admin.
SKILLVATION_AUTO_PUBLISH=true
# Kit and consumable sets per skill area per room (the shop bundles use 4).
SKILLVATION_KITS_PER_ROOM=4
