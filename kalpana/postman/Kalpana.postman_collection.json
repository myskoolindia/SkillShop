            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quoteId\": \"{{quoteId}}\",\n  \"customer\": {\n    \"name\": \"Postman Customer\",\n    \"email\": \"postman@example.test\"\n  },\n  \"confirm\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if(pm.response.code<300) pm.collectionVariables.set(\"orderId\",pm.response.json().order.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Retry purchase without duplication",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/orders",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{conversationToken}}",
