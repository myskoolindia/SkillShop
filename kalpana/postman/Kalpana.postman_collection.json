{
  "info": {
    "name": "Kalpana \u00b7 Gemini package advisor",
    "description": "Run folders in order against a sample catalog. No live money is collected. Set baseUrl and adminToken in the imported environment. See Kalpana/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8787"
    },
    {
      "key": "conversationToken",
      "value": ""
    },
    {
      "key": "otherToken",
      "value": ""
    },
    {
      "key": "quoteId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "documentId",
      "value": ""
    },
    {
      "key": "checkoutMode",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 \u00b7 Start a conversation",
      "description": "Start Kalpana with sample catalog enabled (./run.sh --demo). The requests use sample product IDs. baseUrl has a collection default; adminToken must be set in your environment for the admin folder.",
      "item": [
        {
          "name": "Health and explicit demo/payment mode",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/health",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if(pm.response.code<300) pm.collectionVariables.set(\"checkoutMode\",pm.response.json().checkoutMode);"
                ]
              }
            }
          ]
        },
        {
          "name": "Read approved catalog",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/catalog",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Sample catalog\",()=>pm.expect(pm.response.json().demo).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create private conversation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/conversations",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if(pm.response.code<300) pm.collectionVariables.set(\"conversationToken\",pm.response.json().token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 \u00b7 Advice and customization",
      "description": "With demo mode, responses are deterministic and clearly labeled. With Gemini configured, these same endpoints call Gemini.",
      "item": [
        {
          "name": "Recommend robotics within budget",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/chat",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{conversationToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"I need robotics for 30 students under INR 30,000.\",\n  \"budgetMinor\": 3000000,\n  \"learners\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if(pm.response.code<300) pm.collectionVariables.set(\"quoteId\",pm.response.json().quotes[0].id);",
                  "pm.test(\"Verified amount\",()=>pm.expect(pm.response.json().quotes[0].total).to.eql(2500000));"
                ]
              }
            }
          ]
        },
        {
          "name": "Read conversation and source-grounded response",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/conversation",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{conversationToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Customize with a compatible AI add-on",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/quotes",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{conversationToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"robotics-classroom\",\n      \"quantity\": 1\n    },\n    {\n      \"productId\": \"ai-activities\",\n      \"quantity\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Over budget is blocked\",()=>pm.expect(pm.response.json().purchasable).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject incompatible add-on",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/quotes",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{conversationToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"digital-foundations\",\n      \"quantity\": 1\n    },\n    {\n      \"productId\": \"ai-activities\",\n      \"quantity\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Read original quote",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/quotes/{{quoteId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{conversationToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 \u00b7 Purchase request",
      "description": "A purchase request requires confirmation and customer details. It is NOT a paid order. The undecided provider uses request mode; demo mode returns a local simulation page.",
      "item": [
        {
          "name": "Reject unconfirmed purchase",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/orders",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{conversationToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quoteId\": \"{{quoteId}}\",\n  \"customer\": {\n    \"name\": \"Postman Customer\",\n    \"email\": \"postman@example.test\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
