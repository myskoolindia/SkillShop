<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Kalpana (./kalpana, the Design My Lab planner) runs as its own service on 127.0.0.1:8787 and is
    # served under /kalpana/. Needs mod_proxy + mod_proxy_http (or use ProxyPass in the vhost instead).
    <IfModule mod_proxy.c>
        RewriteRule ^kalpana$ /kalpana/ [R=301,L]
        RewriteRule ^kalpana/(.*)$ http://127.0.0.1:8787/$1 [P,L]
    </IfModule>

    # Pass /club-shop requests directly to Apache alias — do NOT send to Laravel
    RewriteRule ^club-shop(/.*)?$ - [L]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
